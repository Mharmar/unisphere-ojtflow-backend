# Server
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173

# Database (Phase 3)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=ojtflow_app
DB_PASSWORD=change_me_local_password
DB_NAME=ojtflow

# Authentication (Phase 4)
JWT_SECRET=replace_with_at_least_32_characters_random_secret_key
JWT_EXPIRES_IN=2h
JWT_REMEMBER_EXPIRES_IN=7d

# Application Rules (Phase 8)
APPLY_REQUIRES_ELIGIBLE=true

# AI Assistant (Phase 12)
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=